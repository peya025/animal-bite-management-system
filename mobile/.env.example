# Mobile Environment Configuration Template
# -----------------------------------------------------------------------------
# For Local Development:
# Copy this file to `mobile/.env` and update API_BASE_URL to your development host:
#   API_BASE_URL=http://192.168.1.175:8000/api/mobile
#
# For Production Builds:
# DO NOT hardcode local IPs in release builds. Use --dart-define during build:
#   flutter build apk --release \
#     --dart-define=API_BASE_URL=https://your-railway-backend-url.up.railway.app/api/mobile \
#     --dart-define=GOOGLE_SERVER_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# -----------------------------------------------------------------------------

# Demo / Mock Mode (Must be false for real backend & production builds)
USE_MOCK_DATA=false

# API Configuration (Default template - overridden by --dart-define in release mode)
API_BASE_URL=https://your-railway-backend-url.up.railway.app/api/mobile
CLINIC_ID=1

# Google OAuth Server Client ID (Web Client ID for mobile SSO verification)
GOOGLE_SERVER_CLIENT_ID=


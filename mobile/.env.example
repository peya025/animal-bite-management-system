# API Configuration
# 
# RECOMMENDED: Use your computer's hostname (works on any network!)
# Find your hostname: Run "hostname" in terminal
# Format: http://YOUR_HOSTNAME.local:8000/api/mobile
API_BASE_URL=http://hazelslaptop.local:8000/api/mobile
#
# ALTERNATIVE: Use IP address (must change when switching networks)
# Find your IP: ipconfig (Windows) or ifconfig (Mac/Linux)
# Examples:
# Home WiFi:   http://192.168.1.100:8000/api/mobile
# Office WiFi: http://192.168.0.50:8000/api/mobile
# School WiFi: http://10.0.0.25:8000/api/mobile
#
# USB DEBUGGING: Use special Android localhost address
# API_BASE_URL=http://10.0.2.2:8000/api/mobile
# (Requires: adb reverse tcp:8000 tcp:8000)
#
CLINIC_ID=1

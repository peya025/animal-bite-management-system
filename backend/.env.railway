# Copy these names into Railway Variables. Do not upload this file or a real .env.
APP_NAME="Animal Bite Management System"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://animal-bite-management-system-production.up.railway.app
APP_KEY=base64:FiiIpQp+BVShAUJvSA3OHhdm+IgLzFe7pw4NlL2UlkE=
APP_TIMEZONE=Asia/Manila
LOG_LEVEL=warning

# Exact Vercel production origin; no trailing slash.
FRONTEND_URL=https://animal-bite-management-system.vercel.app
PUBLIC_REGISTRATION_ENABLED=false
PUBLIC_SETUP_ENABLED=false
DEVELOPER_TOOLS_ENABLED=false
SANCTUM_TOKEN_EXPIRY_MINUTES=1440

# Configure these from Railway's MySQL service variables in the dashboard.
DB_CONNECTION=mysql
DB_HOST=${{MySQL.MYSQLHOST}}
DB_PORT=${{MySQL.MYSQLPORT}}
DB_DATABASE=${{MySQL.MYSQLDATABASE}}
DB_USERNAME=${{MySQL.MYSQLUSER}}
DB_PASSWORD=${{MySQL.MYSQLPASSWORD}}

# Bearer-token API authentication does not require a mobile CORS origin.
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
QUEUE_CONNECTION=sync
CACHE_STORE=database
MAIL_MAILER=log

# Required only when seeding a brand-new synthetic demo database.
SEED_DEMO_DATA=false
DEMO_ADMIN_PASSWORD=
DEMO_STAFF_PASSWORD=

# Required only when Google staff sign-in is enabled.
#GOOGLE_REDIRECT_URI=https://animal-bite-management-system-production.up.railway.app/api/auth/google/callback

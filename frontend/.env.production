# Set this in the Vercel Production environment before building.
VITE_API_URL=https://animal-bite-management-system-production.up.railway.app/api
# Backward-compatible alias; set it to the same value if older builds need it.
VITE_API_BASE_URL=https://animal-bite-management-system-production.up.railway.app/api
VITE_GOOGLE_CLIENT_ID=

# Laravel Reverb WebSocket Client Configuration (Railway Production)
# Must match the REVERB_APP_KEY configured in Railway
VITE_REVERB_APP_KEY=
# Dedicated Reverb service domain on Railway (e.g. reverb-production-xxxx.up.railway.app)
VITE_REVERB_HOST=
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https

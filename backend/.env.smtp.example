# Backend-only SMTP setup. Do not put credentials in frontend/mobile .env.
# MAIL_* settings take precedence over SMTP_* aliases: remove old MAIL_* placeholders first.
MAIL_MAILER=smtp
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME="Tagoloan Animal Bite Treatment Center"
# Equivalent: MAIL_HOST, MAIL_PORT, MAIL_SCHEME=smtp, MAIL_USERNAME,
# MAIL_PASSWORD, MAIL_FROM_ADDRESS, MAIL_FROM_NAME. Port 465 requires MAIL_SCHEME=smtps
# or SMTP_SECURE=true. false means mandatory STARTTLS, never unencrypted SMTP.
# MAIL_URL is deliberately rejected; use explicit settings above.
APP_URL=https://your-api.example
FRONTEND_URL=https://your-staff-app.example
# APP_BASE_URL is an alias fallback; explicit APP_URL/FRONTEND_URL are recommended.
MOBILE_APP_BASE_URL=
EMAIL_ENABLED=true
EMAIL_APPOINTMENT_EVENTS_ENABLED=true
MESSAGING_TEST_MODE=true
MESSAGING_TEST_RECIPIENTS=authorized-test-mailbox@example.test
MESSAGING_QUEUE_CONNECTION=database
EMAIL_PER_MINUTE=30
# Retain APP_KEY securely; encrypted invitation tokens and ledger need it.

# Copy these names into Railway Variables. Do not upload this file or a real .env.
APP_NAME="Animal Bite Management System"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://your-railway-backend-url.up.railway.app
APP_KEY=
APP_TIMEZONE=Asia/Manila
LOG_LEVEL=warning

# Exact Vercel production origin; no trailing slash.
FRONTEND_URL=https://your-vercel-project.vercel.app
PUBLIC_REGISTRATION_ENABLED=false
PUBLIC_SETUP_ENABLED=false
DEVELOPER_TOOLS_ENABLED=false
SANCTUM_TOKEN_EXPIRY_MINUTES=1440

# Configure these from Railway's MySQL service variables in the dashboard.
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Bearer-token API authentication does not require a mobile CORS origin.
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
QUEUE_CONNECTION=sync
CACHE_STORE=database
MAIL_MAILER=log

# Required only when seeding a brand-new synthetic demo database.
SEED_DEMO_DATA=false
DEMO_ADMIN_PASSWORD=
DEMO_STAFF_PASSWORD=

# Required only when Google staff sign-in is enabled.
GOOGLE_REDIRECT_URI=https://your-railway-backend-url.up.railway.app/api/auth/google/callback

# Outbound SMS/email (disabled until provider and sender verification)
MESSAGING_QUEUE_CONNECTION=database
SMS_ENABLED=false
EMAIL_ENABLED=false
SMS_PROVIDER=fake
MESSAGING_TEST_MODE=true
# Comma-separated normalized +63 numbers and exact email addresses
MESSAGING_TEST_RECIPIENTS=
SMS_PER_MINUTE=30
EMAIL_PER_MINUTE=30
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=

# Firebase Cloud Messaging (FCM HTTP v1)
# Keep automatic FCM notifications disabled by default (FCM_ENABLED=false) until credentials and recipients are verified.
FCM_ENABLED=false
FCM_TEST_MODE=false
FIREBASE_PROJECT_ID=abtc-management-system
GOOGLE_APPLICATION_CREDENTIALS=storage/app/private/firebase-credentials.json
FCM_ANDROID_CHANNEL_ID=abtcare_reminders
FCM_ALLOWED_PATIENT_ACCOUNT_IDS=1

# Secure Firebase Credentials Injection:
# Option 1 (Recommended): Base64-encoded JSON service account key.
#   Generate with: base64 -w 0 path/to/firebase-credentials.json
#   Paste the single-line string into FIREBASE_CREDENTIALS_BASE64 in Railway Variables.
FIREBASE_CREDENTIALS_BASE64=

# Option 2: Raw JSON string of the Firebase service account credentials.
#   Paste the entire JSON string into FIREBASE_CREDENTIALS_JSON in Railway Variables.
FIREBASE_CREDENTIALS_JSON=

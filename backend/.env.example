APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Manila

FRONTEND_URL=http://localhost:5173

# Security Flags
PUBLIC_REGISTRATION_ENABLED=false
# Keep false in production. Local setup remains available while APP_ENV=local.
PUBLIC_SETUP_ENABLED=false
DEVELOPER_TOOLS_ENABLED=false
SANCTUM_TOKEN_EXPIRY_MINUTES=1440

# Open vial maximum hours - must be approved by the clinic's clinical authority before changing
OPEN_VIAL_MAX_HOURS=8

# MySQL concurrency tests: use a dedicated disposable MySQL 8 database only.
# These are intentionally disabled for normal PHPUnit runs.
MYSQL_CONCURRENCY_TESTING=false
MYSQL_CONCURRENCY_TEST_DATABASE=

SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=animalbitecenter
DB_USERNAME=root
DB_PASSWORD=

# Seeding Configuration
# Set to true: Creates sample clinic & test users (skip setup wizard)
# Set to false: Empty database, setup wizard will appear
SEED_DEFAULT_CLINIC=true

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# Demo Seeder Configuration (for fresh synthetic demo instances only).
# Supply unique values only through the Railway Variables dashboard.
DEMO_ADMIN_PASSWORD=
DEMO_STAFF_PASSWORD=
SEED_DEMO_DATA=false

BROADCAST_CONNECTION=reverb

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_SERVER_HOST="0.0.0.0"
REVERB_SERVER_PORT=8080
REVERB_HOST="127.0.0.1"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Filesystem Configuration
FILESYSTEM_DISK=local

# S3 / Cloudflare R2 / Spaces Configuration (When FILESYSTEM_DISK=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ─────────────────────────────────────────────
# Google OAuth 2.0 — Identity Federation (SSO)
# ─────────────────────────────────────────────
# Obtain from: Google Cloud Console → APIs & Services → Credentials
# Web Application client for the Clinical Staff Portal
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Callback URL registered in Google Cloud Console
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Outbound SMS/email (disabled until provider and sender verification)
MESSAGING_QUEUE_CONNECTION=database
SMS_ENABLED=false
EMAIL_ENABLED=false
SMS_PROVIDER=fake
MESSAGING_TEST_MODE=true
# Comma-separated normalized +63 numbers and exact email addresses
MESSAGING_TEST_RECIPIENTS=
SMS_PER_MINUTE=30
EMAIL_PER_MINUTE=30
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=

# ─────────────────────────────────────────────
# Firebase Cloud Messaging (FCM) & Push Notifications
# ─────────────────────────────────────────────
# Global automatic push delivery (set false to prevent automated patient messages)
FCM_ENABLED=false
# Test mode: when true, test dispatches return simulated responses locally without calling Firebase API.
# When false, controlled test commands (php artisan fcm:test) communicate with live Firebase HTTP v1 API.
FCM_TEST_MODE=false
FIREBASE_PROJECT_ID=abtc-management-system
GOOGLE_APPLICATION_CREDENTIALS=storage/app/private/firebase-credentials.json
FCM_ANDROID_CHANNEL_ID=abtcare_reminders
# Configurable FCM test account allowlist (comma-separated IDs, e.g. 1 or 1,2; or * for unrestricted)
# Restricts automatic FCM push delivery strictly to authorized test accounts during local testing
FCM_ALLOWED_PATIENT_ACCOUNT_IDS=1


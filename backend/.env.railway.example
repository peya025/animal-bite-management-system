# Copy these names into Railway Variables. Do not upload this file or a real .env.
APP_NAME="Animal Bite Management System"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://your-railway-backend-url.up.railway.app
APP_KEY=
APP_TIMEZONE=Asia/Manila
LOG_LEVEL=warning

# Exact Vercel production origin; no trailing slash.
FRONTEND_URL=https://your-vercel-project.vercel.app
PUBLIC_REGISTRATION_ENABLED=false
PUBLIC_SETUP_ENABLED=false
DEVELOPER_TOOLS_ENABLED=false
SANCTUM_TOKEN_EXPIRY_MINUTES=1440

# Configure these from Railway's MySQL service variables in the dashboard.
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Bearer-token API authentication does not require a mobile CORS origin.
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
QUEUE_CONNECTION=sync
CACHE_STORE=database
MAIL_MAILER=log

# Required only when seeding a brand-new synthetic demo database.
SEED_DEMO_DATA=false
DEMO_ADMIN_PASSWORD=
DEMO_STAFF_PASSWORD=

# Required only when Google staff sign-in is enabled.
GOOGLE_REDIRECT_URI=https://your-railway-backend-url.up.railway.app/api/auth/google/callback

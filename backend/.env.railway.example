# Copy these names into Railway Variables. Do not upload this file or a real .env.
APP_NAME="Animal Bite Management System"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://your-railway-backend-url.up.railway.app
APP_KEY=
APP_TIMEZONE=Asia/Manila
LOG_LEVEL=warning

# Exact Vercel production origin(s); comma-separated if multiple; no trailing slash.
FRONTEND_URL=https://your-vercel-project.vercel.app
PUBLIC_REGISTRATION_ENABLED=false
PUBLIC_SETUP_ENABLED=false
DEVELOPER_TOOLS_ENABLED=false
SANCTUM_TOKEN_EXPIRY_MINUTES=1440

# Configure these from Railway's MySQL service variables in the dashboard.
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Bearer-token API authentication does not require a mobile CORS origin.
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# Queue configuration: set to 'database' when using the dedicated Railway Queue Worker (sh railway/run-worker.sh)
QUEUE_CONNECTION=database
CACHE_STORE=database
MAIL_MAILER=log
# For live invitations, set MAIL_MAILER=smtp and EMAIL_ENABLED=true after
# configuring a verified sender below. Never use log/array as delivery proof.
# Port 587 uses smtp with required STARTTLS; port 465 uses smtps.
MAIL_SCHEME=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Tagoloan Animal Bite Treatment Center"
# Leave MAIL_URL unset: the application requires explicit SMTP settings.

# Required only when seeding a brand-new synthetic demo database.
SEED_DEMO_DATA=false
DEMO_ADMIN_PASSWORD=
DEMO_STAFF_PASSWORD=

# Required only when Google staff sign-in is enabled.
GOOGLE_REDIRECT_URI=https://your-railway-backend-url.up.railway.app/api/auth/google/callback

# ─────────────────────────────────────────────────────────────────────────────
# Laravel Reverb WebSocket Broadcasting (Dedicated Railway Reverb Service)
# ─────────────────────────────────────────────────────────────────────────────
# Shared by App, Queue Worker, and Reverb services.
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=897821
REVERB_APP_KEY=abtc-reverb-prod-key
REVERB_APP_SECRET=abtc-reverb-prod-secret

# Internal Reverb Server Binding (Used only by the Reverb container)
# Railway forwards incoming traffic to container port $PORT (defaults to 8080)
REVERB_SERVER_HOST="0.0.0.0"
REVERB_SERVER_PORT=8080

# Public Reverb WebSocket Endpoint (Public domain provisioned by Railway for Reverb)
# Railway edge reverse proxy terminates TLS on port 443 and proxies to container $PORT
# Used by the Vercel React frontend (WSS) and default Laravel backend broadcaster
REVERB_HOST=your-reverb-service.up.railway.app
REVERB_PORT=443
REVERB_SCHEME=https

# Optional: Internal backend broadcast connection (for Railway Private Networking)
# If App/Worker communicate with Reverb over Railway private mesh network instead of public URL.
# If unset, defaults to REVERB_HOST, REVERB_PORT, and REVERB_SCHEME above.
# REVERB_API_HOST=reverb.railway.internal
# REVERB_API_PORT=8080
# REVERB_API_SCHEME=http

# Reverb Allowed Origins (comma-separated origins/domains allowed to open WebSockets)
# Use '*' for unrestricted or specify your Vercel domains (e.g. your-app.vercel.app,*.vercel.app)
REVERB_ALLOWED_ORIGINS=*

# Optional: Enable verbose terminal logging on the Reverb container
REVERB_DEBUG=false

# ─────────────────────────────────────────────────────────────────────────────
# Outbound SMS/Email Messaging
# ─────────────────────────────────────────────────────────────────────────────
MESSAGING_QUEUE_CONNECTION=database
SMS_ENABLED=false
EMAIL_ENABLED=false
SMS_PROVIDER=fake
MESSAGING_TEST_MODE=true
# Keep test mode enabled for controlled verification and allowlist the test
# recipients below. Set false only when ready to deliver to actual patients/staff.
# Comma-separated normalized +63 numbers and exact email addresses
MESSAGING_TEST_RECIPIENTS=
SMS_PER_MINUTE=30
EMAIL_PER_MINUTE=30
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=

# ─────────────────────────────────────────────────────────────────────────────
# Firebase Cloud Messaging (FCM HTTP v1)
# ─────────────────────────────────────────────────────────────────────────────
# Keep automatic FCM notifications disabled by default (FCM_ENABLED=false) until credentials and recipients are verified.
FCM_ENABLED=false
FCM_TEST_MODE=false
FIREBASE_PROJECT_ID=abtc-management-system
GOOGLE_APPLICATION_CREDENTIALS=storage/app/private/firebase-credentials.json
FCM_ANDROID_CHANNEL_ID=abtcare_reminders
FCM_ALLOWED_PATIENT_ACCOUNT_IDS=1

# Secure Firebase Credentials Injection:
# Option 1 (Recommended): Base64-encoded JSON service account key.
#   Generate with: base64 -w 0 path/to/firebase-credentials.json
#   Paste the single-line string into FIREBASE_CREDENTIALS_BASE64 in Railway Variables.
FIREBASE_CREDENTIALS_BASE64=

# Option 2: Raw JSON string of the Firebase service account credentials.
#   Paste the entire JSON string into FIREBASE_CREDENTIALS_JSON in Railway Variables.
FIREBASE_CREDENTIALS_JSON=

# ─────────────────────────────────────────────────────────────────────────────
# Cloud File Storage (Cloudflare R2 - Prevents file loss on redeploy)
# ─────────────────────────────────────────────────────────────────────────────
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=abtc-storage
AWS_URL=https://pub-402c28737cc34c0cada9b79c25c1c177.r2.dev
AWS_ENDPOINT=https://6d56c0dfba015fb55aba481989d80203.r2.cloudflarestorage.com
AWS_USE_PATH_STYLE_ENDPOINT=false

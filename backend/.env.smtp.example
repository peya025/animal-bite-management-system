# Backend-only Gmail SMTP. Do not put credentials in frontend/mobile environment files.
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SCHEME=smtp
MAIL_USERNAME=yezitsdansoy@gmail.com
# Enter the generated Gmail App Password locally; never commit it.
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=yezitsdansoy@gmail.com
MAIL_FROM_NAME="Tagoloan Animal Bite Treatment Center"
# config/mail.php requires STARTTLS and validates certificates.
# Do not add MAIL_ENCRYPTION or MAIL_URL overrides.
EMAIL_ENABLED=true
MESSAGING_TEST_MODE=true
# Add only explicitly authorized test recipients during verification.
MESSAGING_TEST_RECIPIENTS=
EMAIL_APPOINTMENT_EVENTS_ENABLED=true
EMAIL_PER_MINUTE=30
MESSAGING_QUEUE_CONNECTION=database
# Preserve your actual application URLs. localhost links work only on this computer.
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# Copy these names into Railway Variables. Do not upload this file or a real .env.
APP_NAME="Animal Bite Management System"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://your-railway-backend-url.up.railway.app
APP_KEY=
APP_TIMEZONE=Asia/Manila
LOG_LEVEL=warning

# Exact Vercel production origin; no trailing slash.
FRONTEND_URL=https://your-vercel-project.vercel.app
PUBLIC_REGISTRATION_ENABLED=false
PUBLIC_SETUP_ENABLED=false
DEVELOPER_TOOLS_ENABLED=false
SANCTUM_TOKEN_EXPIRY_MINUTES=1440

# Configure these from Railway's MySQL service variables in the dashboard.
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Bearer-token API authentication does not require a mobile CORS origin.
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
QUEUE_CONNECTION=sync
CACHE_STORE=database
MAIL_MAILER=log
# For live invitations, set MAIL_MAILER=smtp and EMAIL_ENABLED=true after
# configuring a verified sender below. Never use log/array as delivery proof.
# Port 587 uses smtp with required STARTTLS; port 465 uses smtps.
MAIL_SCHEME=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Tagoloan Animal Bite Treatment Center"
# Leave MAIL_URL unset: the application requires explicit SMTP settings.

# Required only when seeding a brand-new synthetic demo database.
SEED_DEMO_DATA=false
DEMO_ADMIN_PASSWORD=
DEMO_STAFF_PASSWORD=

# Required only when Google staff sign-in is enabled.
GOOGLE_REDIRECT_URI=https://your-railway-backend-url.up.railway.app/api/auth/google/callback

# Outbound SMS/email (disabled until provider and sender verification)
MESSAGING_QUEUE_CONNECTION=database
SMS_ENABLED=false
EMAIL_ENABLED=false
SMS_PROVIDER=fake
MESSAGING_TEST_MODE=true
# Keep test mode enabled for controlled verification and allowlist the test
# recipients below. Set false only when ready to deliver to actual patients/staff.
# Comma-separated normalized +63 numbers and exact email addresses
MESSAGING_TEST_RECIPIENTS=
SMS_PER_MINUTE=30
EMAIL_PER_MINUTE=30
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=

# Cloud File Storage (Cloudflare R2 - Prevents file loss on redeploy)
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=abtc-storage
AWS_URL=https://pub-402c28737cc34c0cada9b79c25c1c177.r2.dev
AWS_ENDPOINT=https://6d56c0dfba015fb55aba481989d80203.r2.cloudflarestorage.com
AWS_USE_PATH_STYLE_ENDPOINT=false

# Set this in the Vercel Production environment before building.
VITE_API_URL=https://your-railway-backend-url.up.railway.app/api
# Backward-compatible alias; set it to the same value if older builds need it.
VITE_API_BASE_URL=https://your-railway-backend-url.up.railway.app/api
VITE_GOOGLE_CLIENT_ID=

# Laravel Reverb WebSocket Client Configuration (Railway Production)
# Must match REVERB_APP_KEY configured in Railway App, Worker, and Reverb services.
VITE_REVERB_APP_KEY=your-production-reverb-app-key
# Public domain of the dedicated Railway Reverb service (e.g. reverb-production-xxxx.up.railway.app).
VITE_REVERB_HOST=reverb-production-xxxx.up.railway.app
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https
